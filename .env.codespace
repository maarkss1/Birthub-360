# GitHub Codespace environment configuration
# Copie este arquivo para .env no Codespace e configure as chaves de API

NODE_ENV=development
PORT=3024
HOST=0.0.0.0

# Para Codespace, configure DATABASE_URL para apontar para seu banco de dados externo
# Exemplo: DATABASE_URL=postgresql://user:password@external-host:5432/prospectordb
DATABASE_URL=postgresql://prospector:prospector_pass@localhost:5434/prospectordb
DIRECT_URL=postgresql://prospector:prospector_pass@localhost:5434/prospectordb

ALLOWED_ORIGINS=http://localhost:3005,http://localhost:5173,http://127.0.0.1:3005,http://127.0.0.1:5173
BETTER_AUTH_URL=http://localhost:3005
BETTER_AUTH_SECRET=hmXnQch3D8pG9BI7w6gZSbTWrjudenNs4UPsxfVaCLk=
SECURE_COOKIES=false
CREDENTIALS_ENCRYPTION_KEY=dcsRW87dqe259L6uqBh87eb+/NcJwfIM0ESXG/CHKqg=
PII_BLIND_INDEX_KEY=CQ+K/mJfl8xPR1+TQsh8vzFEASv7qMtbIxVB8KvcNp4=

# Desabilitar serviços locais no Codespace (configure serviços externos se necessário)
ENABLE_SEARCH=false
ENABLE_QUEUES=false
ENABLE_EMBEDDED_WORKERS=false
REDIS_URL=
MEILI_MASTER_KEY=birthhub_meili_master_key

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=prospector-assets
STORAGE_ACCESS_KEY_ID=birthhub
STORAGE_SECRET_ACCESS_KEY=birthhub_minio_dev_only
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=birthhub
MINIO_SECRET_KEY=birthhub_minio_dev_only

OLLAMA_BASE_URL=http://localhost:11434
