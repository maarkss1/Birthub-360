{
  "$schema": "https://tr.designtokens.org/format/",
  "component": {
    "button": {
      "height": {
        "sm": { "$value": "32px", "$type": "dimension" },
        "md": { "$value": "36px", "$type": "dimension" },
        "lg": { "$value": "44px", "$type": "dimension" }
      },
      "radius": { "$value": "{radius.md}", "$type": "dimension" },
      "font": {
        "size": { "$value": "14px", "$type": "dimension" },
        "lineHeight": { "$value": "20px", "$type": "dimension" },
        "weight": { "$value": "600", "$type": "fontWeight" }
      }
    },
    "input": {
      "height": {
        "sm": { "$value": "32px", "$type": "dimension" },
        "md": { "$value": "36px", "$type": "dimension" },
        "lg": { "$value": "44px", "$type": "dimension" }
      },
      "radius": { "$value": "{radius.md}", "$type": "dimension" }
    },
    "badge": {
      "height": {
        "sm": { "$value": "20px", "$type": "dimension" },
        "md": { "$value": "24px", "$type": "dimension" },
        "lg": { "$value": "28px", "$type": "dimension" }
      },
      "radius": { "$value": "{radius.sm}", "$type": "dimension" }
    },
    "sidebar": {
      "widthExpanded": { "$value": "260px", "$type": "dimension" },
      "widthCollapsed": { "$value": "64px", "$type": "dimension" }
    },
    "header": {
      "height": { "$value": "56px", "$type": "dimension" }
    },
    "container": {
      "dashboardMax": { "$value": "1440px", "$type": "dimension" }
    }
  }
}
