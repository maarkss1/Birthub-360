{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile document storing identity details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "User saved code workspace or project files",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "filesJson": { "type": "string", "maxLength": 1048576 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "filesJson", "createdAt", "updatedAt"]
    },
    "AICreation": {
      "title": "AICreation",
      "description": "Saved AI outputs including music, images, videos, grounded queries, and transcriptions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["music", "image", "video", "search_grounding", "maps_grounding", "transcription", "chat"] },
        "title": { "type": "string", "maxLength": 250 },
        "prompt": { "type": "string", "maxLength": 4000 },
        "model": { "type": "string", "maxLength": 100 },
        "content": { "type": "string", "maxLength": 524288 },
        "metadata": { "type": "string", "maxLength": 100000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "type", "title", "prompt", "model", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Multi-turn Gemini chat conversations with role instructions and messages",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 100 },
        "model": { "type": "string", "maxLength": 100 },
        "messagesJson": { "type": "string", "maxLength": 1048576 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "role", "model", "messagesJson", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User account document"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Workspace projects belonging to the user"
    },
    "/users/{userId}/ai_creations/{creationId}": {
      "schema": { "$ref": "#/entities/AICreation" },
      "description": "AI creations and outputs generated by the user"
    },
    "/users/{userId}/chat_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Chat conversations saved by the user"
    }
  }
}
